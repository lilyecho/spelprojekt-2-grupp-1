  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 65
  indentLevel: 0
  storyText: But Idun told me then, that the Fox in the story wasn't scared of the
    troll!
  description: 
  character: {fileID: 1782153009}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
