  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 67
  indentLevel: 0
  storyText: And if I don't remember wrong, the story ended with the fox sneaking
    past the troll though some bushes and logs.
  description: 
  character: {fileID: 1782153009}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
